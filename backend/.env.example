PROJECT_NAME="AstraChain API"
VERSION="1.0.0"
API_V1_STR="/api"

# Database Configuration (Defaults to SQLite for instant zero-dependency testing, or set PostgreSQL URI)
# PostgreSQL Example: postgresql://postgres:postgres@localhost:5432/astrachain_db
DATABASE_URL="sqlite:///./astrachain.db"

# JWT Authentication
SECRET_KEY="astrachain-super-secret-key-change-in-production-environment"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Logging
LOG_LEVEL="INFO"

# Groq LLM Configuration
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
# Max seconds for one Groq call, and how long agents fall back to deterministic mode after an LLM failure
GROQ_TIMEOUT_SECONDS=20
GROQ_COOLDOWN_SECONDS=60
