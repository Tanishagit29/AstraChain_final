PROJECT_NAME="TransitOps API"
VERSION="1.0.0"
API_V1_STR="/api"

# Database Configuration (Defaults to SQLite for instant zero-dependency testing, or set PostgreSQL URI)
# PostgreSQL Example: postgresql://postgres:postgres@localhost:5432/transitops_db
DATABASE_URL="sqlite:///./transitops.db"

# JWT Authentication
SECRET_KEY="transitops-super-secret-key-change-in-production-environment"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Logging
LOG_LEVEL="INFO"
